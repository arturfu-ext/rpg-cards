{
  "name": "rpg-cards",
  "version": "2.0.0",
  "description": "RPG card generator",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "golden:capture": "playwright test --project=golden-capture",
    "gen:icons": "tsx scripts/generate-icon-manifest.ts",
    "build:icons": "node resources/tools/update-icons.cjs && node resources/tools/update-fonts.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mephitrpg/rpg-cards.git"
  },
  "author": "Robert Autenrieth",
  "contributors": [
    {
      "name": "jure",
      "email": "www.mephit.it@gmail.com",
      "url": "http://www.mephit.it/"
    }
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mephitrpg/rpg-cards/issues"
  },
  "homepage": "https://github.com/mephitrpg/rpg-cards#readme",
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.9",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tinycolor2": "^1.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/tinycolor2": "^1.4.6",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "fs-extra": "^11.3.5",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "linkedom": "^0.18.12",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "request": "^2.88.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "yauzl": "^3.4.0"
  }
}
